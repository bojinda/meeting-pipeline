
`.gitignore`
```gitignore
# Environment / secrets
.env
config/.env
config/*.local
systemd/meeting-capture.service
systemd/meeting-postprocess.service
systemd/meeting-postprocess.path
*.secret
*.token

# Optional local-only identifier audit; never include private identifiers in Git
tests/private-identifiers.txt

# Private spoken-redaction review records, in any output directory
redactions.json
.private-redactions-*.tmp

# Private per-meeting speaker review and roster; no automatic identities
speaker-suggestions.json
speaker_roster.private.json
speaker_aliases.json
speaker_turn_corrections.json
speaker-turns.json
speaker-turns.private.txt
speaker-turn-conflicts.json
.private-speaker-*.tmp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Runtime outputs
/ignore/
meeting-recordings/
meeting-transcripts/
meeting-summaries/
tmp/
cache/

# Audio / transcript artifacts
*.wav
*.mp3
*.m4a
*.flac
*.srt
*.vtt

# Private experimental whole-meeting evidence, plans and metrics
whole-source.json
whole-evidence.json
whole-plan.json
whole-run.json
.whole-experiment-*/

# Explicit opt-in private model response; never publish or commit
whole-model-response.json

# Private opt-in map/reduce chunk experiments
chunk-plan.json
chunk-comparison.json

# Private editorial register, evidence and operator review (never publish)
action-register.private.json
action-register.private.md
editorial-review.private.json
operator-review.private.md
editorial-response.private.json
notes-evidence.private.json
editorial-budgets.private.json
