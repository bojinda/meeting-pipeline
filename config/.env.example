HF_TOKEN=huggingface read token here
WHISPERX_MODEL=large-v2
WHISPERX_BATCH_SIZE=4
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_DEVICE=cuda
WHISPERX_DEVICE_INDEX=0

# Leave empty to use the installed runner's existing physical lock paths.
# Any explicit override must match that configuration; never create new locks.
AIHUB_GPU0_LOCK_FILE=
AIHUB_GPU1_LOCK_FILE=
AIHUB_GPU_LOCK_TIMEOUT=3600

# R2 shared admission: host runner package/Python >=3.11 must be installed
# separately with operational approval. No standalone-flock fallback.
# Config must use the SAME private journal, scope and existing physical locks.
AIHUB_GPU_RUNNER_CONFIG=/etc/aihub-gpu-runner/config.json
AIHUB_GPU_RUNNER_PYTHON=/usr/bin/python3
AIHUB_GPU_OLLAMA_TARGET=ollama
# Optional explicit stable stage ID; use a fresh ID only for reviewed new work.
# AIHUB_GPU_STAGE_ID=meeting-session-gpu-stage

# optional: if you usually know the speaker count, uncomment these
# WHISPERX_MIN_SPEAKERS=2
# WHISPERX_MAX_SPEAKERS=8

TRANSCRIPT_CHUNK_TARGET_WORDS=1400
TRANSCRIPT_CHUNK_MAX_WORDS=2200

# Preserve original recordings, including after successful transcription.
# This matches production retention; deletion is a separate operator policy.
DELETE_SOURCE_AUDIO_AFTER_TRANSCRIPTION=0

OLLAMA_URL=url to ollama
OLLAMA_MAP_MODEL=qwen2.5:32b
OLLAMA_REDUCE_MODEL=qwen2.5:32b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAP_NUM_CTX=16384
OLLAMA_REDUCE_NUM_CTX=32768

# Optional meeting-only overrides; CLI flags take precedence.
# Uncomment to use this recommended map/reduce pair without changing lessons.
# MEETING_MAP_MODEL=qwen3.6:27b
# MEETING_REDUCE_MODEL=qwen3.8:27b
# MEETING_MAP_NUM_CTX=16384
# MEETING_REDUCE_NUM_CTX=32768

# Optional whole-meeting experiment; enabled only by --synthesis-mode whole.
# MEETING_SYNTHESIS_NUM_CTX=98304
# MEETING_SYNTHESIS_MODEL=qwen3.8:27b
# MEETING_SYNTHESIS_TOKENIZER=/private/models/matching-tokenizer/tokenizer.json
# MEETING_SYNTHESIS_THINK=false

# Optional private speaker review (independent of meeting map/reduce context).
# SPEAKER_REVIEW_NUM_CTX=98304
# SPEAKER_REVIEW_TOKENIZER=/private/models/matching-tokenizer/tokenizer.json
# SPEAKER_REVIEW_WINDOW=0
# SPEAKER_REVIEW_THINK=false

LESSON_RECORDINGS_ROOT=/$HOME/meeting-pipeline/lesson-recordings
LESSON_TRANSCRIPTS_ROOT=/$HOME/meeting-pipeline/lesson-transcripts
LESSON_SUMMARIES_ROOT=/$HOME/meeting-pipeline/lesson-summaries
MEETING_SUMMARIES_ROOT=$HOME/meeting-pipeline/meeting-summaries

# Include a separate historical recap section in draft minutes (0 or 1).
MEETING_KEEP_RECAP=0

# Unattended meeting notes use the existing summary wrapper after WhisperX.
# Notes defaults: Qwen3.8:27b, map context 16384, reduce context 196608,
# default thinking, output allowance 49152; explicit summary CLI overrides win.
# Optional source-grounded correction candidate after normal meeting docs.
# Keep disabled until unattended qualification is reviewed; 1 explicitly opts in.
# Original remains selected. Candidate is private, unverified and export-held.
MEETING_NOTES_CORRECTION=0
# MEETING_NOTES_TOKENIZER=$HOME/.cache/meeting-tokenizers/qwen3.5-27b/tokenizer.json
# MEETING_NOTES_ROOT=$HOME/meeting-pipeline/meeting-summaries
# MEETING_NOTES_DUAL_GPU_TARGET=meeting-dual
# The existing named target policy must already authorize unattended operation.
# Set its existing matching approval binding once in the service configuration;
# do not invent a reference or disable the runner's policy checks.
# AIHUB_GPU_DUAL_APPROVAL=EXISTING_OPERATOR_APPROVED_POLICY_REFERENCE

WINDOWS_HOST=audio host ip
WINDOWS_USER=username
WINDOWS_SSH_KEY=/path/to/.ssh/key

WINDOWS_START_TASK=task start name
WINDOWS_STOP_SCRIPT=C:/path/to/stop-meeting-audio.ps1

MEETING_CONTROL_LOG=$HOME/meeting-pipeline/meeting-control.log

LESSON_STATE_DIR=$HOME/meeting-pipeline/lesson-state
LESSON_CONTROLLER_HOST=0.0.0.0
LESSON_CONTROLLER_PORT=8765
LESSON_CONTROLLER_API_KEY=replace-this-with-a-random-string
LESSON_CONTROLLER_SCRIPT_TIMEOUT=30
