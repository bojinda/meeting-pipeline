[Unit]
Description=Run WhisperX on latest lesson recording

[Service]
Type=oneshot
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/meeting-pipeline
ExecStart=/bin/bash -lc 'LATEST="$(cat /home/YOUR_USERNAME/meeting-pipeline/lesson-recordings/last_recording.txt)" && /home/YOUR_USERNAME/meeting-pipeline/bin/postprocess-lesson.sh "$LATEST"'
TimeoutStartSec=infinity
